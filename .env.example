# Példa környezeti fájl az ebusd elindításához (docker compose).
# Másold `.env` néven, és töltsd ki a saját értékeiddel. A `.env` fájl NEM kerül a repóba.
#
# FONTOS: ebbe a fájlba kerülnek a jelszavak — soha ne töltsd fel verziókövetésbe,
# és ne másold be fórumra, hibajegybe vagy chatbe.

# --- eBUS adapter ---------------------------------------------------------------
# Hálózati (WiFi/LAN) adapter esetén: ens:<ip>:<port>  — az „ens” az enhanced protokollt jelenti.
# Soros adapter esetén például: /dev/ttyUSB0
EBUSD_DEVICE=ens:<ADAPTER_IP>:9999

# --- MQTT (OPCIONÁLIS) ----------------------------------------------------------
# Ehhez az integrációhoz NEM kell MQTT: közvetlenül az ebusd TCP portjáról olvas.
# Csak akkor töltsd ki, ha a `packages/` alatti, MQTT-alapú YAML változatot is használod.
MQTT_HOST=<MQTT_BROKER_IP>
MQTT_PORT=1883
MQTT_USER=<MQTT_FELHASZNALO>
MQTT_PASSWORD=<MQTT_JELSZO>

# --- Home Assistant -------------------------------------------------------------
# Az integráció beállításánál megadandó cím (az ebusd gépe, NEM az adapteré).
EBUSD_HOST=<EBUSD_GEP_IP>
EBUSD_PORT=8888
